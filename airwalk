-- ===== MOUSE INPUT HANDLING =====
local mousedown = false
local dragdistance = 0

mainbutton.InputBegan:Connect(function(input, gameprocessed)
	if gameprocessed then return end
	
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		mousedown = true
		dragdistance = 0
		dragstate.lastclicktime = tick()
		dragstate.offset = userinputservice:GetMouseLocation() - mainbutton.AbsolutePosition
	end
end)

mainbutton.InputEnded:Connect(function(input, gameprocessed)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		mousedown = false
		local clickduration = tick() - dragstate.lastclicktime
		
		if clickduration < dragstate.clickthreshold and dragdistance < 10 then
			-- TOGGLE AIRWALK
			if humanoidRootPart then
				scriptstate.platformY = humanoidRootPart.Position.Y - 3
				scriptstate.airwalkon = not scriptstate.airwalkon
				platform.CanCollide = scriptstate.airwalkon
			end
		end
	end
end)

-- ===== KEYBOARD CONTROLS =====
userinputservice.InputBegan:Connect(function(input, gp)
	if gp then return end
	
	if input.KeyCode == Enum.KeyCode.E then
		scriptstate.movingUp = true
	elseif input.KeyCode == Enum.KeyCode.Q then
		scriptstate.movingDown = true
	end
end)

userinputservice.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.E then
		scriptstate.movingUp = false
	elseif input.KeyCode == Enum.KeyCode.Q then
		scriptstate.movingDown = false
	end
end)

-- ===== MAIN LOOP =====
runservice.RenderStepped:Connect(function()
	-- AIRWALK LOGIC
	if humanoidRootPart then
		
		if scriptstate.airwalkon then
			-- Auto-recalc si teleport
			if math.abs(humanoidRootPart.Position.Y - scriptstate.platformY) > 10 then
				scriptstate.platformY = humanoidRootPart.Position.Y - 3
			end
			
			if scriptstate.movingUp then
				scriptstate.platformY = scriptstate.platformY + scriptstate.speed
			end
			
			if scriptstate.movingDown then
				scriptstate.platformY = scriptstate.platformY - scriptstate.speed
			end
			
			platform.Position = Vector3.new(
				humanoidRootPart.Position.X,
				scriptstate.platformY,
				humanoidRootPart.Position.Z
			)
			
			platform.CanCollide = true
		end
		
		-- HEIGHT UPDATE
		heightlabel.Text = "H: " .. string.format("%.3f", humanoidRootPart.Position.Y)
	end
	
	-- UI UPDATE
	if scriptstate.airwalkon then
		statuslabel.Text = "AirWalk\nON ✅"
		statuslabel.TextColor3 = Color3.fromRGB(100, 200, 100)
		iconlabel.Text = "👟"
	else
		statuslabel.Text = "AirWalk\nOFF"
		statuslabel.TextColor3 = Color3.fromRGB(150, 100, 100)
		iconlabel.Text = "👞"
	end
	
	-- DRAG LOGIC
	if mousedown then
		local mousepos = userinputservice:GetMouseLocation()
		local newpos = mousepos - dragstate.offset
		
		dragdistance = (newpos - mainbutton.AbsolutePosition).Magnitude
		
		if dragdistance > 5 then
			mainbutton.Position = UDim2.new(0, newpos.X, 0, newpos.Y)
		end
	end
end)
